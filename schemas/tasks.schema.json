{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ralph tasks schema for alt-image-update-operator",
  "type": "object",
  "required": ["version", "project", "tasks"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "project": {"type": "string"},
    "generated_at": {"type": "string"},
    "status_values": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "dependencies",
          "area",
          "estimated_session",
          "description",
          "files",
          "acceptance_criteria",
          "validation",
          "attempts"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^T[0-9]{3}$"},
          "title": {"type": "string"},
          "status": {"type": "string", "enum": ["queued", "in_progress", "done", "blocked", "failed", "skipped"]},
          "priority": {"type": "integer"},
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "pattern": "^T[0-9]{3}$"}
          },
          "area": {"type": "string"},
          "estimated_session": {"type": "string", "enum": ["small", "medium", "large"]},
          "description": {"type": "string"},
          "files": {"type": "array", "items": {"type": "string"}},
          "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
          "validation": {"type": "array", "items": {"type": "string"}},
          "implementation_notes": {"type": ["string", "null"]},
          "risk": {"type": ["string", "null"]},
          "attempts": {"type": "integer", "minimum": 0},
          "assigned_to": {"type": ["string", "null"]},
          "started_at": {"type": ["string", "null"]},
          "completed_at": {"type": ["string", "null"]},
          "result_summary": {"type": ["string", "null"]},
          "validation_result": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
